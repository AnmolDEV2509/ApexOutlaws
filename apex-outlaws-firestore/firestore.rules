rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == "0u90kcoJ5Wfx1Prvoa5FKv8FZEF2";
    }

    // Player profile and game data. Player-owned fields can be updated by that player,
    // but AC, status and privilege fields are protected from client-side edits.
    match /users/{userId} {
      allow get, list: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24
        && request.resource.data.email is string
        && request.resource.data.status == "active"
        && request.resource.data.currency is map
        && request.resource.data.currency.AC == 0;

      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasNone(["currency", "status", "role", "isAdmin", "admin"]));

      allow delete: if isAdmin()
        || (signedIn() && request.auth.uid == userId);

      match /activity/{activityId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isAdmin()
          || (signedIn()
            && request.auth.uid == userId
            && request.resource.data.type is string
            && request.resource.data.message is string
            && request.resource.data.message.size() <= 200
            && request.resource.data.createdAt is int);
        allow update, delete: if isAdmin();
      }
    }

    // News is public to read. Only the configured admin can publish/edit/delete.
    match /news/{postId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 90
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 5000
        && request.resource.data.category is string
        && request.resource.data.createdAt is int;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Keep other collections closed unless you add explicit game-specific rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
